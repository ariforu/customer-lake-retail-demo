flowchart LR
  classDef core fill:#1F6FB2,stroke:#0B2E4F,stroke-width:2px,color:#FFFFFF
  classDef cdp fill:#E8F1FB,stroke:#1F6FB2,stroke-width:1.5px,color:#0B2E4F
  classDef evt fill:#EAF7EF,stroke:#1E8E4E,stroke-width:1.5px,color:#0E3B22
  classDef gold fill:#FFF8E1,stroke:#B8860B,stroke-width:1px,color:#4A3800
  classDef ext fill:#FFF6E5,stroke:#C98A00,stroke-width:1px,color:#5A3E00

  subgraph GOLD["retail_gold  -  Delta tables, refreshed by strideforge_medallion"]
    direction TB
    G1["customer_profile · customer_consent<br/>customer_traits · customer_predictions<br/>household_profile · customer_identity_map"]:::gold
    G2["purchase_events · purchase_line_items<br/>return_events · digital_events<br/>run_activity_events · message_engagement_events<br/>loyalty / race_registration / support / review _events<br/>trigger_events"]:::gold
    G3["product_catalog_enriched<br/>customer_product_recommendations"]:::gold
    G4["identity_resolution_stats"]:::gold
  end

  subgraph CDP["retail_cdp  -  views the Customer Lake entity points at"]
    direction LR
    PROFILE["<b>customer_profile</b><br/><i>profile table, key unified_customer_id</i>"]:::core
    ONE["<b>1 : 1</b><br/>customer_consent<br/>customer_traits<br/>customer_top_recommendation"]:::cdp
    EV["<b>Event tables</b>  (event id + timestamp)<br/>purchase_item_events · digital_product_events<br/>return_item_events · run_shoe_events<br/>message_engagement_events · loyalty_events<br/>race_registration_events · support_events<br/>review_events · trigger_events"]:::evt
    PROFILE --- ONE
    PROFILE -->|"1 : many"| EV
  end

  LAKE(["<b>Customer Lake</b><br/>attributes · audiences · syncs"]):::ext
  DEST(["Braze · SFMC · Meta · Google ..."]):::ext

  G1 -->|"1:1 views"| PROFILE
  G2 -->|"1:1 views + product details"| EV
  G3 -->|"product details"| EV
  G3 -->|"#1 pick"| ONE
  CDP ==> LAKE
  LAKE ==>|"syncs"| DEST
  DEST -.->|"opens, clicks, purchases flow back into bronze, then gold"| GOLD
