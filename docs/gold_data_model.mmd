flowchart LR
  classDef core fill:#1F6FB2,stroke:#0B2E4F,stroke-width:2px,color:#FFFFFF
  classDef cdp fill:#E8F1FB,stroke:#1F6FB2,stroke-width:1.5px,color:#0B2E4F
  classDef evt fill:#EAF7EF,stroke:#1E8E4E,stroke-width:1.5px,color:#0E3B22
  classDef ana fill:#F4F4F4,stroke:#8A8A8A,stroke-width:1px,color:#333333
  classDef ext fill:#FFF6E5,stroke:#C98A00,stroke-width:1px,color:#5A3E00

  subgraph CL["Used by Customer Lake  -  entity: Retail - StrideForge Customer"]
    direction LR
    PROFILE["<b>customer_profile</b><br/><i>profile table, key unified_customer_id</i>"]:::core
    ONE["<b>1 : 1</b><br/>customer_consent<br/>customer_traits<br/>customer_predictions"]:::cdp
    HH["<b>many : 1</b><br/>household_profile"]:::cdp
    MANY["<b>1 : many</b><br/>customer_identity_map<br/>customer_product_recommendations"]:::cdp
    EV["<b>Event tables</b>  (event id + timestamp)<br/>purchase_events · return_events<br/>digital_events · message_engagement_events<br/>run_activity_events · loyalty_events<br/>race_registration_events · support_events<br/>review_events"]:::evt
    LINES["<b>purchase_line_items</b><br/><i>1 : many from purchase_events</i>"]:::cdp
    CATALOG["<b>product_catalog_enriched</b><br/><i>many : 1 on sku</i>"]:::cdp

    PROFILE --- ONE
    PROFILE --> HH
    PROFILE --> MANY
    PROFILE --> EV
    EV -->|"order_id"| LINES
    LINES -->|"sku"| CATALOG
    EV -.->|"sku (digital, return, review, run)"| CATALOG
    MANY -.->|"sku (recommendations)"| CATALOG
  end

  subgraph OTHER["Other gold"]
    direction TB
    TRIG["trigger_events<br/><i>journey triggers</i>"]:::ana
    IRS["identity_resolution_stats<br/><i>identity-resolution proof</i>"]:::ana
  end

  LAKE(["<b>Customer Lake</b><br/>attributes · audiences · syncs"]):::ext
  DEST(["Braze · SFMC · Meta · Google ..."]):::ext

  CL ==> LAKE
  LAKE ==>|"syncs"| DEST
  DEST -.->|"opens, clicks, purchases flow back into bronze, then the event tables"| EV
