erDiagram
  customer_profile ||--|| customer_consent : "contactability gate"
  customer_profile ||--|| customer_traits : "behaviour"
  customer_profile ||--|| customer_predictions : "scores"
  customer_profile }o--o| household_profile : "household_id"
  customer_profile ||--o{ customer_identity_map : "identifiers"
  customer_profile ||--o{ customer_product_recommendations : "top-5"
  customer_profile ||--o{ purchase_events : "orders"
  customer_profile ||--o{ return_events : "returns"
  customer_profile ||--o{ digital_events : "web / app"
  customer_profile ||--o{ message_engagement_events : "email / sms / push"
  customer_profile ||--o{ run_activity_events : "runs"
  customer_profile ||--o{ loyalty_events : "points"
  customer_profile ||--o{ race_registration_events : "races"
  customer_profile ||--o{ support_events : "tickets"
  customer_profile ||--o{ review_events : "reviews"
  customer_profile ||--o{ trigger_events : "journey triggers"
  purchase_events ||--|{ purchase_line_items : "order_id"
  customer_profile ||--o{ purchase_item_events : "order lines + product (view)"
  purchase_line_items }o--|| product_catalog_enriched : "sku"
  customer_product_recommendations }o--|| product_catalog_enriched : "sku"
  digital_events }o--o| product_catalog_enriched : "sku"
  return_events }o--o| product_catalog_enriched : "sku"
  review_events }o--o| product_catalog_enriched : "sku"
  run_activity_events }o--o| product_catalog_enriched : "sku (shoe)"
  trigger_events }o--o| product_catalog_enriched : "sku"

  customer_profile {
    string unified_customer_id PK
    string household_id FK
    string loyalty_tier
    boolean email_contactable
  }
  customer_consent {
    string unified_customer_id PK
  }
  customer_traits {
    string unified_customer_id PK
    string lifecycle_stage
  }
  customer_predictions {
    string unified_customer_id PK
    double churn_probability
  }
  household_profile {
    string household_id PK
    int member_count
  }
  customer_identity_map {
    string unified_customer_id FK
    string id_type
  }
  customer_product_recommendations {
    string unified_customer_id FK
    int rank
    string sku FK
  }
  purchase_events {
    string order_id PK
    timestamp order_ts
    decimal revenue_usd
  }
  purchase_line_items {
    string order_line_id PK
    string order_id FK
    string sku FK
    decimal revenue_usd
  }
  product_catalog_enriched {
    string sku PK
    string category
    string stock_status
  }
  purchase_item_events {
    string order_line_id PK
    timestamp order_ts
    string style_name
    string category
  }
  return_events {
    string return_id PK
    timestamp return_ts
  }
  digital_events {
    string event_id PK
    timestamp event_ts
  }
  message_engagement_events {
    string message_event_id PK
    timestamp event_ts
  }
  run_activity_events {
    string activity_id PK
    timestamp start_ts
  }
  loyalty_events {
    string ledger_id PK
    timestamp activity_ts
  }
  race_registration_events {
    string registration_id PK
    timestamp registered_at
  }
  support_events {
    string ticket_id PK
    timestamp created_at
  }
  review_events {
    string review_id PK
    timestamp submitted_at
  }
  trigger_events {
    string trigger_id PK
    timestamp trigger_ts
    string trigger_type
  }
